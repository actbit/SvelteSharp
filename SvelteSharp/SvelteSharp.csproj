<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SvelteSharp</RootNamespace>
    <PackageId>SvelteSharp</PackageId>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- A meta-package has dependencies but no lib/ref output; NU5128 is expected. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Meta-package that references the SvelteSharp core runtime, both JavaScript engine adapters (Jint and Okojo), and the MSBuild integration. Install this package to get the full setup and choose an engine at runtime.</Description>
    <Authors>actbit</Authors>
    <PackageTags>svelte;ssr;aspnetcore;hydration;csr</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/actbit/SvelteSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvelteSharp.Core\SvelteSharp.Core.csproj" />
    <ProjectReference Include="..\SvelteSharp.Jint\SvelteSharp.Jint.csproj" />
    <ProjectReference Include="..\SvelteSharp.Okojo\SvelteSharp.Okojo.csproj" />
    <ProjectReference Include="..\SvelteSharp.Build\SvelteSharp.Build.csproj" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
