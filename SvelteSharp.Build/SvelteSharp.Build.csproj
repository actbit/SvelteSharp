<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SvelteSharp.BuildTasks</RootNamespace>
    <AssemblyName>SvelteSharp.Build</AssemblyName>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Description>MSBuild integration that restores the external Svelte toolchain and compiles Svelte views for SvelteSharp.</Description>
    <Authors>actbit</Authors>
    <PackageTags>svelte;sveltesharp;msbuild;build</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/actbit/SvelteSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvelteSharp\SvelteSharp.csproj" />
    <ProjectReference Include="..\SvelteSharp.Engine.Jint\SvelteSharp.Engine.Jint.csproj" />
    <None Include="buildTransitive\SvelteSharp.Build.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="$(OutputPath)*.dll" Pack="true" PackagePath="tools\net10.0\" Visible="false" />
    <None Include="$(OutputPath)SvelteSharp.Build.deps.json;$(OutputPath)SvelteSharp.Build.runtimeconfig.json" Pack="true" PackagePath="tools\net10.0\" Visible="false" />
  </ItemGroup>

</Project>
